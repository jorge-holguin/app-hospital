{
  "cli": {
    "version": ">= 18.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SOLICITUDES_CITA_BASE_URL": "https://citas.hospitalchosica.gob.pe/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SOLICITUDES_CITA_BASE_URL": "https://citas.hospitalchosica.gob.pe/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
